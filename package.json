{
  "name": "feeder",
  "version": "1.0.0",
  "description": "Scan from an HP ScanJet (or any macOS-supported scanner) straight into a web app.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "sh scripts/build-helper.sh",
    "prestart": "sh scripts/build-helper.sh",
    "start": "node server.js",
    "scanner-info": "sh scripts/build-helper.sh && ./bin/scanhelper info"
  }
}
