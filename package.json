{
  "name": "feeder",
  "version": "1.0.0",
  "description": "Scan from an HP ScanJet (or any scanner macOS or Windows supports) straight into a web app.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "scripts": {
    "build": "node scripts/build-helper.js",
    "prestart": "node scripts/build-helper.js",
    "start": "node server.js",
    "scanner-info": "node scripts/build-helper.js && node scripts/run-helper.js info"
  }
}
